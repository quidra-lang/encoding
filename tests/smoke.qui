import encoding

bin bytes = "Hello".utf8()
string encoded = encoding.base64.encode(bytes)
print.line("{encoded}")
bin decoded = encoding.base64.decode(encoded)
string original = string.from_utf8(decoded)
print.line("{original}")
print.line("{encoding.base64.encode(bin.fill(0, 0))}")
match encoding.base64.decode("Zg=")
    bin unexpected
        print.line("unexpected")
    error failure
        print.line("length-error")
match encoding.base64.decode("Zh==")
    bin unexpected
        print.line("unexpected")
    error failure
        print.line("pad-bit-error")
match encoding.base64.encode(bin.fill(3, 0))
    string unexpected
        print.line("unexpected")
    error failure
        print.line("unaligned-error")
