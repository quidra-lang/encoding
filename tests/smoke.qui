import encoding

bin bytes := "Hello".utf8()
string encoded := encoding.base64.encode(bytes)
println("{encoded}")
bin decoded := encoding.base64.decode(encoded)
string original := string.from_utf8(decoded)
println("{original}")
println("{encoding.base64.encode(bin.fill(0, 0))}")
match encoding.base64.decode("Zg=")
    bin unexpected
        println("unexpected")
    error failure
        println("length-error")
match encoding.base64.decode("Zh==")
    bin unexpected
        println("unexpected")
    error failure
        println("pad-bit-error")
match encoding.base64.encode(bin.fill(3, 0))
    string unexpected
        println("unexpected")
    error failure
        println("unaligned-error")
